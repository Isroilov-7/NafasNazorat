# Copy to .env on the server (chmod 600). Never commit real values.
# deploy/install.sh creates .env automatically with random secrets.
# Generate:  openssl rand -base64 48
SESSION_SECRET=

# First admin account (created once, on first start, if no such email exists).
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Optional demo doctor + fictional demo patients for the review / pilot site.
DEMO_DOCTOR_EMAIL=
DEMO_DOCTOR_PASSWORD=
NAFAS_DEMO_DATA=1
# One-click "Demoni ko'rish" login as the demo doctor (ONLY with fictional demo data).
NAFAS_DEMO_LOGIN=1
